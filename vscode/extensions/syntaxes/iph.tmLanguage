<?xml version="1.0" encoing="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DID PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>IPH</key>
        <string>source.iph</string>

        <key>fileTypes</key>
        <array>
            <string>iph</string>
            <string>ip</string>
            <string>h.iph</string>
            <string>h.ip</string>
            <string>e.iph</string>
            <string>e.ip</string>
        </array>

        <key>name</key>
        <string>IPH file</string>

        <key>patterns</key>
        <array>
            <dict>
                <key>match</key>
                <string>\b(?i:(hint|info|information))\b</string>
                <key>name</key>

                <string>info-token</string>
            </dict>
            <dict>
                <key>match</match>
                <string>\b(?i:(warning|warn))\n</string>
                <key>name</key>
                <string>warn-token</string>
            </dict>
            <dict>
                <key>match</key>
                <string>\b(?i:(Error|Faliure|Fail))\b</string>
                <string>constant.numeric</string>
            </dict>
            <dict>
                <key>match</key>
                <string>\b((0(x|X)[0-9a-fA-F]*)|(([0-9]+\.?[0-9]*)|(\.[0-9]+))((e|E)(\+|-)?[0-9]+)_L|1|UL|u1|u|U|F|f|ll|LL|ull|ULL)?b</string>
                <key>name</key>
                <string>constant.numeric</string>
            </dict>
        </array>
        <key>uuid</key>
        <string></string>
    </dict>
</plist>